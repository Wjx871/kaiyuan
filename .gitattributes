# 统一换行符，避免 Windows / macOS 同学提交时产生整文件 diff
* text=auto eol=lf

# 二进制资源不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary

# 这两类文件在 GitHub 上按语言高亮统计
*.json linguist-language=JSON
*.js   linguist-language=JavaScript
